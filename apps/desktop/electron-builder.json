{
  "appId": "aegis.agentops.preview",
  "productName": "AEGIS Agent Ops",
  "copyright": "Copyright (c) 2026 aegisintelmetry",
  "asar": true,
  "asarUnpack": ["node_modules/@google/gemini-cli/**"],
  "afterPack": "./after-pack.cjs",
  "directories": { "output": "release" },
  "files": ["dist/**", "electron/**", "branding/**", "package.json", "workspace-limits.json"],
  "extraResources": [
    { "from": "../../LICENSE", "to": "LICENSE" },
    { "from": "../../NOTICE", "to": "NOTICE" },
    { "from": "stage/THIRD-PARTY-NOTICES.txt", "to": "THIRD-PARTY-NOTICES.txt" },
    { "from": "stage/btk-desktop-core", "to": "core", "filter": ["**/*"] },
    { "from": "stage/desktop-release.json", "to": "desktop-release.json" }
  ],
  "npmRebuild": false,
  "win": {
    "icon": "branding/azwol.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "AEGIS-Agent-Ops-Setup-${version}.${ext}",
    "requestedExecutionLevel": "asInvoker",
    "signExecutable": false
  },
  "nsis": {
    "installerIcon": "branding/azwol.ico",
    "uninstallerIcon": "branding/azwol.ico",
    "include": "installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "installerLanguages": ["ko_KR", "en_US"]
  },
  "publish": { "provider": "github", "owner": "aegisintelmetry", "repo": "agent-ops-personal", "releaseType": "release" }
}
